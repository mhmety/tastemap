# Application Configuration
APP_NAME=TasteMap
DEBUG=false

# PostgreSQL Database Configuration
POSTGRES_USER=tastemap
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=tastemap

# SQLAlchemy Database Connection URL (used by FastAPI and Alembic)
DATABASE_URL=postgresql://tastemap:your_secure_postgres_password_here@localhost:5432/tastemap

# JWT Authentication Configuration
# Generate a secure random key, e.g., with `openssl rand -hex 32`
SECRET_KEY=generate_a_strong_random_secret_key_here_for_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# SerpAPI Key (Optional: for Google Maps / Google Reviews synchronization)
SERPAPI_KEY=your_serpapi_key_here

# CORS Allowed Origins (Comma-separated URLs or JSON array)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
